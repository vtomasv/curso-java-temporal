<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>4.1.0</version><relativePath/></parent>
  <groupId>com.bancared</groupId><artifactId>clase-15-banca</artifactId><version>1.0.0</version>
  <name>Clase 15 - BancoRed</name>
  <properties><java.version>25</java.version><temporal.version>1.37.0</temporal.version><lab.excluded>lab-e01,lab-e02,lab-e03</lab.excluded><lab.included></lab.included></properties>
  <dependencies>
    <dependency><groupId>com.rabbitmq</groupId><artifactId>amqp-client</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-thymeleaf</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
    <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>io.temporal</groupId><artifactId>temporal-sdk</artifactId><version>${temporal.version}</version></dependency>
    <!-- El modo embebido usa el servidor de pruebas real del SDK, sin consola web. Solo laboratorio local. -->
    <dependency><groupId>io.temporal</groupId><artifactId>temporal-testing</artifactId><version>${temporal.version}</version></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build><plugins>
    <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><configuration><excludedGroups>${lab.excluded}</excludedGroups><groups>${lab.included}</groups></configuration></plugin>
  </plugins></build>
  <profiles>
    <profile><id>lab-e01</id><properties><lab.excluded></lab.excluded><lab.included>lab-e01</lab.included></properties></profile>
    <profile><id>lab-e02</id><properties><lab.excluded></lab.excluded><lab.included>lab-e02</lab.included></properties></profile>
    <profile><id>lab-e03</id><properties><lab.excluded></lab.excluded><lab.included>lab-e03</lab.included></properties></profile>
    <profile><id>laboratorios</id><properties><lab.excluded></lab.excluded></properties></profile>
  </profiles>
</project>
